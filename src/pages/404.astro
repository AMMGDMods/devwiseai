---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page could not be found." noindex>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>That page doesn’t exist.</h1>
      <p>It may have moved, or the link may be mistyped. Try the <a href="/blog/">article list</a> or go <a href="/">back home</a>.</p>
    </div>
  </section>
</BaseLayout>
