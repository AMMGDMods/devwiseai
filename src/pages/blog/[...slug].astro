---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getPosts, categoryOf, formatDate, readingTime, slugifyTag } from '../../lib/posts';
import { SITE_URL, SITE_NAME } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const cat = categoryOf(post.data.category);
const path = `/blog/${post.id}/`;
const url = new URL(path, SITE_URL).href;
const toc = headings.filter((h) => h.depth === 2);
const related = all.filter((p) => p.id !== post.id).slice(0, 2);
const initials = post.data.author.split(' ').map((w) => w[0]).slice(0, 2).join('');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author: { '@type': 'Person', name: post.data.author, url: new URL('/about/', SITE_URL).href },
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      logo: { '@type': 'ImageObject', url: new URL('/logo-512.png', SITE_URL).href },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image: new URL('/og-default.png', SITE_URL).href,
    articleSection: cat.name,
    keywords: post.data.tags.join(', '),
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', SITE_URL).href },
      { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(`/category/${cat.slug}/`, SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
    ],
  },
];
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={path}
  ogType="article"
  jsonLd={jsonLd}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
>
  <article>
    <header class="container">
      <div class="article-head">
        <div class="meta"><a class="cat" href={`/category/${cat.slug}/`}>{cat.name}</a></div>
        <h1>{post.data.title}</h1>
        <p class="desc">{post.data.description}</p>
        <div class="byline">
          <span class="avatar" aria-hidden="true">{initials}</span>
          <span>
            <strong>{post.data.author}</strong><br />
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            · {readingTime(post.body)} min read
          </span>
        </div>
      </div>
    </header>

    <div class="container article-layout">
      <div>
        <AdSlot name="article-top" />
        <div class="prose">
          <Content />
        </div>
        <AdSlot name="article-bottom" />
        {post.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="Tags">
            {post.data.tags.map((t) => <li><a class="chip" href={`/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
          </ul>
        )}
        <div class="author-box">
          <span class="avatar" aria-hidden="true">{initials}</span>
          <div>
            <strong>{post.data.author}</strong>
            <p>Software developer and founder of MIGOTEK. Writes about using AI tools in day-to-day development without giving up code quality. <a href="/about/">More about DevWiseAI</a>.</p>
          </div>
        </div>
      </div>
      {toc.length > 2 && (
        <nav class="toc" aria-label="Table of contents">
          <h2>On this page</h2>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2>Keep reading</h2><a href="/blog/">All articles →</a></div>
        <div class="post-grid">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>
