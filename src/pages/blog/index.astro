---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, slugifyTag } from '../../lib/posts';
import { CATEGORIES } from '../../consts';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<BaseLayout title="Blog" description="Every DevWiseAI article: AI tools for developers, programming tutorials, software reviews and developer productivity." path="/blog/">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">The blog</span>
      <h1>All articles</h1>
      <p>Guides and reviews about using AI well in real software work. Browse by topic or tag.</p>
      <div class="hero-cats">
        <a class="chip" href="/blog/" aria-current="page">All</a>
        {CATEGORIES.map((c) => <a class="chip" href={`/category/${c.slug}/`}>{c.name}</a>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="post-grid three">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      {tags.length > 0 && (
        <>
          <div class="section-head" style="margin-top:40px"><h2>Tags</h2></div>
          <div class="hero-cats" style="margin-top:0">
            {tags.map((t) => <a class="chip" href={`/tags/${slugifyTag(t)}/`}>#{t}</a>)}
          </div>
        </>
      )}
    </div>
  </section>
</BaseLayout>
