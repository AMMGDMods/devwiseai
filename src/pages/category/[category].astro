---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
import { CATEGORIES } from '../../consts';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.category === cat.slug);
---
<BaseLayout title={`${cat.name} articles`} description={cat.description} path={`/category/${cat.slug}/`}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Category</span>
      <h1>{cat.name}</h1>
      <p>{cat.description}</p>
      <div class="hero-cats">
        <a class="chip" href="/blog/">All</a>
        {CATEGORIES.map((c) => <a class="chip" href={`/category/${c.slug}/`} aria-current={c.slug === cat.slug ? 'page' : undefined}>{c.name}</a>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      {posts.length > 0 ? (
        <div class="post-grid three">{posts.map((post) => <PostCard post={post} />)}</div>
      ) : (
        <p class="empty">New {cat.name.toLowerCase()} articles are on the way. In the meantime, <a href="/blog/">browse all articles</a>.</p>
      )}
    </div>
  </section>
</BaseLayout>
