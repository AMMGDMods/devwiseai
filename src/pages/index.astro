---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getPosts } from '../lib/posts';
import { CATEGORIES, SITE_URL, SITE_NAME, SITE_DESCRIPTION } from '../consts';

const posts = await getPosts();
const [first, ...rest] = posts;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: SITE_URL + '/',
    description: SITE_DESCRIPTION,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL + '/',
    logo: SITE_URL + '/logo-512.png',
    parentOrganization: { '@type': 'Organization', name: 'MIGOTEK' },
  },
];
---
<BaseLayout path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">AI for developers, minus the hype</span>
      <h1>Write better code <em>with</em> AI, not just more of it.</h1>
      <p class="lede">DevWiseAI publishes practical guides on AI coding tools, hands-on programming tutorials and criteria-driven software reviews, written by a working developer for working developers.</p>
      <div class="hero-cats">
        {CATEGORIES.map((c) => <a class="chip" href={`/category/${c.slug}/`}>{c.name}</a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Latest articles</h2>
        <a href="/blog/">All articles →</a>
      </div>
      <div class="post-grid three">
        {first && <PostCard post={first} featured />}
        {rest.slice(0, 8).map((post) => <PostCard post={post} />)}
      </div>
      <AdSlot name="home-below-latest" />
    </div>
  </section>
</BaseLayout>
